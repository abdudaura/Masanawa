# Masanawa Alpha 1 development-only environment names.
# Never commit real values. Run `pnpm alpha:prepare` once against the dev DB
# to generate the canonical IDs/token values below.

MASANAWA_ALPHA_ENABLED=true
MASANAWA_ALPHA_DEV_TOKEN=<generated-by-alpha-bootstrap>
MASANAWA_ALPHA_TENANT_ID=<tenant_...>
MASANAWA_ALPHA_USER_ID=<user_...>
MASANAWA_ALPHA_POLICY_REVISION=alpha-1
MASANAWA_ALPHA_RELATIONSHIPS_JSON=<generated-character-to-relationship-json>

MASANAWA_ALPHA_GEMINI_API_KEY=<development-provider-key>
MASANAWA_ALPHA_GEMINI_MODEL=<development-model-name>

MASANAWA_DATABASE_URL=<development-postgresql-url>
MASANAWA_GATEWAY_HOST=0.0.0.0
MASANAWA_GATEWAY_PORT=3000
