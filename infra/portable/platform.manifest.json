{
  "version": 1,
  "project": "masanawa",
  "targetBranch": "main",
  "database": {
    "engine": "postgresql",
    "image": "pgvector/pgvector:0.8.6-pg18-bookworm",
    "dataPath": "/var/lib/postgresql",
    "portableVia": [
      "pg_dump",
      "pg_restore",
      "repository migrations"
    ]
  },
  "services": [
    {
      "name": "database",
      "serviceName": "masanawa-db",
      "engine": "postgresql-18-pgvector",
      "image": "pgvector/pgvector:0.8.6-pg18-bookworm",
      "dataPath": "/var/lib/postgresql",
      "portability": "pg_dump/pg_restore + repository migrations"
    },
    {
      "name": "gateway",
      "serviceName": "masanawa-gateway",
      "repo": "Baatiku/masanawa",
      "branch": "main",
      "publicUrl": "https://gateway.masanawa.com"
    },
    {
      "name": "worker",
      "serviceName": "masanawa-worker",
      "repo": "Baatiku/masanawa",
      "branch": "main",
      "publicUrl": null
    },
    {
      "name": "ops",
      "serviceName": "masanawa-ops",
      "repo": "Baatiku/masanawa",
      "branch": "main",
      "publicUrl": "https://ops.masanawa.com"
    },
    {
      "name": "billing",
      "publicUrl": "https://billing.masanawa.com",
      "status": "legacy deployment; add only after a real main-branch Masanawa billing HTTP entrypoint exists"
    },
    {
      "name": "calls",
      "publicUrl": "https://calls.masanawa.com",
      "status": "legacy call/APK-builder deployment; converge to main before adding to IaC"
    },
    {
      "name": "admin",
      "publicUrl": "https://nurain.masanawa.com",
      "status": "legacy ChatWithStars source; migrate into Baatiku/masanawa before adding to portable core"
    }
  ],
  "invariants": [
    "Client code uses only *.masanawa.com URLs",
    "No provider-generated hostname is an application contract",
    "No plaintext secret is committed to Git",
    "Schema changes are migrations",
    "A new Railway account needs only a Railway deployment credential once application secrets are stored in GitHub production secrets"
  ]
}
