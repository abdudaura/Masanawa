# Copy to a private file outside the checkout; chmod 600. Never commit real values.
# Use URL-safe random values (for example hex) for the password and tokens.
MASANAWA_DATABASE_PASSWORD=
MASANAWA_ALPHA_DEV_TOKEN=
MASANAWA_ALPHA_GEMINI_API_KEY=
# Verify current provider availability before setting the replaceable model.
MASANAWA_ALPHA_GEMINI_MODEL=
# A real hostname with DNS pointing to the new Masanawa Droplet.
MASANAWA_ALPHA_GATEWAY_DOMAIN=
# APK build inputs: HTTPS hostname above and the same Alpha token.
MASANAWA_ALPHA_GATEWAY_URL=
MASANAWA_APK_DOWNLOAD_TOKEN=
