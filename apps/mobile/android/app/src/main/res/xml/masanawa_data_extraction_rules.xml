<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Masanawa stores bearer tokens, encrypted local conversation cache,
         offline drafts and wallet/account state. On Android 12+ the old
         allowBackup=false flag alone cannot reliably disable OEM device-to-device
         transfers. Deliberately transfer no app-owned user data in either mode.
         History must be recovered by authenticating to the authoritative server. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
