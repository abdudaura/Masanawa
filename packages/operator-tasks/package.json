{
  "name": "@masanawa/operator-tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "production": "./dist/postgres.js",
      "default": "./src/postgres.ts"
    },
    "./recovery": {
      "types": "./src/recovery.ts",
      "production": "./dist/recovery.js",
      "default": "./src/recovery.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@masanawa/contracts": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "@types/pg": "8.23.1"
  }
